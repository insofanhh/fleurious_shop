{
  "name": "fleurious-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && next build --webpack",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test.ts",
    "test:http": "npm run build && cross-env HTTP_STATUS_TEST=1 npm test",
    "test:push": "node --import tsx --test tests/push-client.test.ts tests/push-config.test.ts",
    "push:setup": "tsx scripts/setup-push.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "tsx scripts/setup.ts",
    "worker": "tsx scripts/worker.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:e2e": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/luxon3": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-select": "2.4.1",
    "@socket.io/redis-adapter": "8.3.0",
    "@tanstack/react-table": "8.21.3",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "3.0.3",
    "bullmq": "6.7.6",
    "cross-env": "10.1.0",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "18.0.10",
    "fontkit": "^3.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "lucide-react": "1.72.0",
    "luxon": "3.7.2",
    "motion": "14.14.0",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "otpauth": "9.6.0",
    "pdfkit": "^0.20.2",
    "prisma": "7.10.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "svg-to-pdfkit": "^0.1.8",
    "tsx": "4.23.15",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/svg-to-pdfkit": "^0.1.5",
    "@types/web-push": "3.6.4",
