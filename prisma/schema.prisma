generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
}
model MediaAsset {
  id String @id @db.VarChar(41)
  data Bytes @db.MediumBlob
  createdAt DateTime @default(now())
}
model User {
  id String @id @default(cuid())
  email String @unique @db.VarChar(254)
  name String
  phone String @default("")
  passwordHash String
  googleSubject String? @unique @db.VarChar(255)
  role String @default("CUSTOMER")
  verified Boolean @default(false)
  disabled Boolean @default(false)
  totpEnabled Boolean @default(false)
  totpSecretEncrypted String? @db.Text
  totpPendingEncrypted String? @db.Text
  totpPendingExpires DateTime?
  totpLastStep Int @default(0)
  recoveryHashes Json?
  memberSince DateTime?
  tier String @default("Member")
  birthDate String? @db.VarChar(10)
  membershipMigrated Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
  orders Order[]
  periods MemberPeriod[]
  days ActiveDay[]
  claims QrClaim[]
  rewards Reward[]
  favorites Favorite[]
  addresses Address[]
  notifications Notification[]
  pushes PushSubscription[]
  collections CodReceivable[]
  collectionsReceived OrderReceipt[]
}
model GoogleLoginAttempt {
  id String @id @db.VarChar(64)
  browserHash String @db.VarChar(64)
  verifierEncrypted String @db.Text
  nonce String @db.VarChar(64)
  nextPath String @db.VarChar(1024)
  linkUserId String?
  userId String?
  status String @default("PENDING") @db.VarChar(20)
  expiresAt DateTime
  @@index([expiresAt])
}
model Session {
  id String @id
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model Verification {
  id String @id
  email String
  kind String
  expiresAt DateTime
  @@index([email, kind])
}
model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  subtitle String
  description String @db.Text
  category String
  occasion String
  color String
  image String @db.VarChar(2048)
  images Json
  badge String @default("")
  featured Boolean @default(false)
  active Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  variants ProductVariant[]
  favorites Favorite[]
}
model Taxonomy {
  id String @id @default(cuid())
  kind String
  name String
  slug String @unique
  description String @db.Text
  image String @default("") @db.VarChar(2048)
  productIds Json
  active Boolean @default(true)
}
model Review {
  id String @id @default(cuid())
  userId String
  orderId String
  productId String
  authorName String
  rating Int
  body String @db.Text
  status String @default("PENDING")
  createdAt DateTime @default(now())
  @@unique([userId, orderId, productId])
  @@index([productId, status])
}
model ProductVariant {
  id String @id @default(cuid())
  productId String
  name String
  sku String @unique
  price Int
  stock Int @default(20)
  reserved Int @default(0)
  product Product @relation(fields: [productId], references: [id])
  @@index([productId])
}
model Favorite {
  userId String
  productId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([userId, productId])
}
model Address {
  id String @id @default(cuid())
  userId String
  name String
  phone String
  address String @db.VarChar(800)
  zoneId String?
  placeId String? @db.VarChar(2048)
  formattedAddress String? @db.VarChar(500)
  addressDetails String @default("") @db.VarChar(200)
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  verifiedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model DeliveryZone {
  id String @id @default(cuid())
  name String
  fee Int
  active Boolean @default(true)
}
model DeliverySlot {
  id String @id @default(cuid())
  label String
  startHour Int
  endHour Int
  capacity Int @default(12)
  active Boolean @default(true)
}
model SlotBooking {
  id String @id @default(cuid())
  day String
  slotId String
  count Int @default(0)
  @@unique([day, slotId])
}
model Order {
  id String @id @default(cuid())
  code String @unique
  idempotencyKey String @unique
  userId String?
  guestHash String?
  analyticsClientId String?
  source String @default("WEBSITE")
  createdBy String?
  expiredAt DateTime?
  buyerName String
  buyerEmail String @db.VarChar(254)
  recipientName String
  recipientPhone String
  address String @db.VarChar(800)
  zoneId String?
  shippingMethod String @default("ZONE") @db.VarChar(20)
  shippingSnapshot Json?
  shippingQuoteId String?
  deliveryDay String
  slotId String
  slotLabel String
  deliveryStart DateTime?
  deliveryEnd DateTime?
  deliveredAt DateTime?
  paidAt DateTime?
  cardMessage String @db.Text
  cardWritingMode String @default("AUTO")
  note String @db.Text
  status String @default("PENDING")
  fulfillment String @default("UNASSIGNED")
  paymentStatus String @default("UNPAID")
  paymentMethod String
  manualPayment Boolean @default(false)
  paymentDueAt DateTime?
  subtotal Int
  discount Int @default(0)
  deliveryFee Int
  total Int
  discountLabel String @default("")
  memberPeriodId String?
  memberState String?
  rewardId String?
  expiresAt DateTime
  stockState String @default("RESERVED")
  version Int @default(1)
  assignee String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id])
  items OrderItem[]
  history OrderHistory[]
  qr QrGrant?
  payments Payment[]
  refunds Refund[]
  receivable CodReceivable?
  receipt OrderReceipt?
  @@index([deliveryDay, fulfillment])
  @@index([userId, createdAt])
  @@index([paymentStatus, expiresAt])
}
model ShippingLocation {
  id String @id @default(cuid())
  owner String @db.VarChar(150)
  placeId String @db.VarChar(2048)
  address String @db.VarChar(500)
  latitude Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model ShippingQuote {
  id String @id @default(cuid())
  owner String @db.VarChar(150)
  destinationKey String @db.VarChar(64)
  policyVersion Int
  fee Int
  snapshot Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([owner, destinationKey, policyVersion, expiresAt])
  @@index([expiresAt])
}
model ShippingRouteCache {
  key String @id @db.VarChar(64)
  distanceMeters Int
  durationSeconds Int
  expiresAt DateTime
  @@index([expiresAt])
}
model CodReceivable {
  id String @id @default(cuid())
  orderId String @unique
  kind String @default("CUSTOMER") @db.VarChar(20)
  state String @default("OPEN") @db.VarChar(20)
  amount Int
  payerName String @db.VarChar(100)
  payerPhone String @default("") @db.VarChar(30)
  ownerId String?
  dueAt DateTime
  nextReminderAt DateTime
  lastContactAt DateTime?
  note String @default("") @db.VarChar(500)
  settledAt DateTime?
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id])
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  events CollectionEvent[]
  @@index([state, dueAt])
  @@index([state, nextReminderAt])
}
model OrderReceipt {
  id String @id @default(cuid())
  orderId String @unique
  amount Int
  destination String @db.VarChar(20)
  collectorId String?
  actorId String
  reference String @db.VarChar(100)
  receivedAt DateTime @default(now())
  remittedAt DateTime?
  remittanceReference String @default("") @db.VarChar(100)
  order Order @relation(fields: [orderId], references: [id])
  collector User? @relation(fields: [collectorId], references: [id], onDelete: SetNull)
}
model CollectionEvent {
  id String @id @default(cuid())
  receivableId String
  actorId String
  action String @db.VarChar(40)
  note String @db.VarChar(500)
  createdAt DateTime @default(now())
  receivable CodReceivable @relation(fields: [receivableId], references: [id])
  @@index([receivableId, createdAt])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  variantId String
  name String
  variantName String
  image String @db.VarChar(2048)
  quantity Int
  price Int
  discount Int @default(0)
  order Order @relation(fields: [orderId], references: [id])
}
model OrderHistory {
  id String @id @default(cuid())
  orderId String
  text String
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id])
}
model MemberPeriod {
  id String @id @default(cuid())
  userId String
  month String
  limit Int
  reserved Int @default(0)
  consumed Int @default(0)
  tierLimits Json?
  user User @relation(fields: [userId], references: [id])
  @@unique([userId, month])
}
model MemberLedger {
  id String @id @default(cuid())
  periodId String
  orderId String
  action String
  createdAt DateTime @default(now())
  @@unique([orderId, action])
}
model QrGrant {
  id String @id @default(cuid())
  orderId String @unique
  tokenHash String @unique
  tokenEncrypted String @db.Text
  maxClaims Int @default(1)
  claimsCount Int @default(0)
  eligibleAt DateTime?
  expiresAt DateTime?
  revoked Boolean @default(false)
  order Order @relation(fields: [orderId], references: [id])
  claims QrClaim[]
}
model QrClaim {
  id String @id @default(cuid())
  grantId String
  userId String
  day String
  createdAt DateTime @default(now())
  grant QrGrant @relation(fields: [grantId], references: [id])
  user User @relation(fields: [userId], references: [id])
  @@unique([userId, grantId])
}
model ActiveDay {
  id String @id @default(cuid())
  userId String
  day String
  image String @db.VarChar(2048)
  productName String
  sourceGrantId String
  valid Boolean @default(true)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@unique([userId, day])
}
model Reward {
  id String @id @default(cuid())
  userId String
  ruleKey String
  period String
  title String @db.VarChar(400)
  percent Int
  cap Int
  minimum Int
  productId String?
  validDays Int @default(30)
  threshold Int @default(5)
  earnedDay String @default("")
  status String @default("AVAILABLE")
  reservedOrderId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@unique([userId, ruleKey, period])
}
model Voucher {
  id String @id @default(cuid())
  code String @unique
  title String
  percent Int
  cap Int
  minimum Int
  limit Int
  used Int @default(0)
  active Boolean @default(true)
  expiresAt DateTime
}
model VoucherUse {
  id String @id @default(cuid())
  voucherId String
  orderId String @unique
  state String @default("RESERVED")
}
model Payment {
  id String @id @default(cuid())
  providerId String @unique
  identityHash String? @unique @db.VarChar(64)
  reference String
  orderId String?
  membershipInvoiceId String?
  amount Int
  state String
  reason String @default("")
  receivedAt DateTime @default(now())
  order Order? @relation(fields: [orderId], references: [id])
  membershipInvoice MembershipInvoice? @relation(fields: [membershipInvoiceId], references: [id])
}
model Refund {
  id String @id @default(cuid())
  orderId String
  amount Int
  merchandiseAmount Int @default(0)
  reason String
  status String @default("PENDING")
  reference String @default("")
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id])
}
model Setting {
  key String @id
  value Json
  version Int @default(1)
  updatedAt DateTime @updatedAt
}
model Content {
  id String @id @default(cuid())
  kind String
  slug String @unique
  title String
  body String @db.Text
  image String @default("") @db.VarChar(2048)
  active Boolean @default(true)
  createdAt DateTime @default(now())
}
model Notification {
  id String @id @default(cuid())
  dedupKey String? @unique
  userId String
  title String
  body String
  url String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
}
model PushSubscription {
  id String @id @default(cuid())
  userId String
  endpointHash String @unique
  subscription Json
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Outbox {
  id String @id @default(cuid())
  userId String?
  event String
  payload Json
  sent Boolean @default(false)
  attempts Int @default(0)
  leasedUntil DateTime?
  createdAt DateTime @default(now())
  @@index([sent, createdAt])
  @@index([createdAt])
}
model Audit {
  id String @id @default(cuid())
  actorId String
  action String
  entityId String
  detail Json
  createdAt DateTime @default(now())
}
model RateLimit {
  id String @id
  count Int @default(1)
  expiresAt DateTime
}
model JobRun {
  id String @id
  name String
  status String
  attempts Int @default(0)
  availableAt DateTime @default(now())
  detail String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, availableAt])
}

model MembershipTier {
  id String @id @default(cuid())
  code String @unique @db.VarChar(40)
  name String @db.VarChar(80)
  rank Int @unique
  description String @db.VarChar(400)
  color String @default("#6e1423") @db.VarChar(7)
  active Boolean @default(true)
  monthlyEnabled Boolean @default(false)
  yearlyEnabled Boolean @default(false)
  revision Int @default(1)
  versions MembershipTierVersion[]
  createdAt DateTime @default(now())
}

model MembershipTierVersion {
  id String @id @default(cuid())
  tierId String
  number Int
  quota Int
  percent Int
  cap Int
  minimum Int @default(0)
  monthlyPrice Int
  yearlyPrice Int
  spendThreshold Int
  birthdayPercent Int @default(0)
  birthdayCap Int @default(0)
  birthdayMinimum Int @default(0)
  birthdayDays Int @default(30)
  terms String @default("membership-v2")
  publishedAt DateTime @default(now())
  tier MembershipTier @relation(fields: [tierId], references: [id])
  entitlements MembershipEntitlement[]
  invoices MembershipInvoice[]
  @@unique([tierId, number])
}

model MembershipEntitlement {
  id String @id @default(cuid())
  userId String
  tierVersionId String
  source String @db.VarChar(20)
  sourceKey String @unique @db.VarChar(180)
  startsAt DateTime
  endsAt DateTime?
  revokedAt DateTime?
  anchorAt DateTime?
  months Int @default(0)
  prepaidValue Int @default(0)
  spendRequired Int @default(0)
  reason String @db.VarChar(400)
  actorId String?
  invoiceId String? @unique
  createdAt DateTime @default(now())
  tierVersion MembershipTierVersion @relation(fields: [tierVersionId], references: [id])
  @@index([userId, revokedAt, startsAt, endsAt])
}

model MembershipInvoice {
  id String @id @default(cuid())
  code String @unique @db.VarChar(20)
  userId String
  tierVersionId String
  idempotencyKey String @unique @db.VarChar(100)
  cycle String @db.VarChar(10)
  kind String @db.VarChar(20)
  status String @default("DRAFT") @db.VarChar(20)
  amount Int
  gross Int
  credit Int @default(0)
  startsAt DateTime
  endsAt DateTime
  anchorAt DateTime
  baseEntitlementId String?
  fingerprint String @db.VarChar(64)
  acceptedAt DateTime?
  activatedAt DateTime?
  expiresAt DateTime
  reason String @default("") @db.VarChar(400)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tierVersion MembershipTierVersion @relation(fields: [tierVersionId], references: [id])
  payments Payment[]
  refunds MembershipRefund[]
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model MembershipRefund {
  id String @id @default(cuid())
  invoiceId String
  amount Int
  reason String @db.VarChar(400)
  reference String @default("") @db.VarChar(100)
  status String @default("PENDING") @db.VarChar(20)
  revokeAccess Boolean @default(false)
  actorId String
  createdAt DateTime @default(now())
  completedAt DateTime?
  invoice MembershipInvoice @relation(fields: [invoiceId], references: [id])
}

model MembershipSpendLedger {
  id String @id @default(cuid())
  userId String
  orderId String
  sourceKey String @unique @db.VarChar(180)
  amount Int
  reason String @db.VarChar(400)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model MembershipHistory {
  id String @id @default(cuid())
  userId String
  action String @db.VarChar(40)
  entitlementId String?
  actorId String?
  detail Json
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

